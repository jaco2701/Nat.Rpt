				<xsd:annotation>
					<xsd:documentation>
								Identifica la localidad de procedencia
								del grano a liquidar.
							</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="codProvProcedencia" type="LpgCodProvProcedenciaType" minOccurs="1" maxOccurs="1"/>
			<xsd:element name="datosAdicionales" type="LpgDatosAdicionalesType" minOccurs="0" maxOccurs="1"/>
			<xsd:element name="certificados" type="LpgArrCertType" minOccurs="0" maxOccurs="1"/>
			<xsd:element name="opcionales" type="LpgArrOpcionalType" minOccurs="0" maxOccurs="1"/>
