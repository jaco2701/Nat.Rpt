			<xsd:element name="CodJurisRet" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Código de Jurisdicción </xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DscJurisRet" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Jurisdicción de Impuestos Municipales </xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
