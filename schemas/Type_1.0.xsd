				<xsd:annotation>
					<xsd:documentation>
								Determina si interviene un corredor en
								la liquidacion. En caso afirmativo
								informar cuit corredor, comision
								corredor e ingresos brutos del corredor.
								El ingreso bruto informar solo en los
								casos en donde el que liquida sea el
								corredor. Si liquida el comprador no
								informar.
							</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="liquidaCorredor" type="LpgSiNoType" minOccurs="1" maxOccurs="1">
				<xsd:annotation>
					<xsd:documentation>
								Determina si el que se encuentra
								liquidando es el corredor. En caso de
								ser el corredor quien esta liquidando,
								los datos que lo identifican deben
								coincidir con los datos del
								representado.
							</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
