			<xsd:element name="codTipoOperacion" type="LpgCodTipoOperacionType" minOccurs="1" maxOccurs="1">
				<xsd:annotation>
					<xsd:documentation>
								Codigo del Tipo de Operacion.
							</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="esLiquidacionPropia" type="LpgSiNoType" minOccurs="0" maxOccurs="1">
				<xsd:annotation>
					<xsd:documentation>
								Si es liquidacion propia, los datos del
								comprador deben ser iguales a los datos
								del vendedor. Solo informar cuando
								liquida Comprador
							</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="esCanje" type="LpgEsCanjeType" minOccurs="0" maxOccurs="1">
				<xsd:annotation>
					<xsd:documentation>
								Informar solo cuando el tipo de
								operacion es 01 - Compra Venta
							</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="codPuerto" type="LpgCodPuertoType" minOccurs="1" maxOccurs="1"/>
