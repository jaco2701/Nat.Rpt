	<xsd:complexType name="ImpuestosType">
		<xsd:annotation>
			<xsd:documentation>Tipo definido para expresar Impuestos</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="TipoImp">
				<xsd:annotation>
					<xsd:documentation>Tipo de impuesto</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="IVA"/>
						<xsd:enumeration value="IIBB"/>
						<xsd:enumeration value="IPM"/>
						<xsd:enumeration value="III"/>
						<xsd:enumeration value="IOE"/>
						<xsd:enumeration value="OT"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="TasaImp" type="PctType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Tasa de impuesto</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:choice>
				<xsd:element name="CodTipoIva" type="CodTipoIVAType" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>
              Código de tipo IVA
              1- No Gravado
              2- Exento
              3- 0%
              4- 10,50%
              5- 21%
              6- 27%
            </xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="CodTipoTrib" type="CodTipoTribType" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>
              Código de tipo tributo
              01- Impuestos nacionales
              02- Impuestos provinciales
              03- Impuestos municipales
              04- Impuestos internos
              99- Otros
            </xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:choice>
			<xsd:element name="BaseImp" type="MontoType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Base imponible </xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ImpteImp" type="MontoType">
				<xsd:annotation>
					<xsd:documentation>Importe del impuesto</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="CodJurisImp" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Código de Jurisdicción </xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DscJurisImp" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Jurisdicción de Impuestos Municipales </xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Descripcion" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Descripción del tributo para el caso TipoImp = 99(Otros)</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="RetencionesType">
		<xsd:annotation>
