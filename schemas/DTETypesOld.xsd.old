			<xs:element name="NmbAduana" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Nombre de la aduana</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="60"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FechaDcto" type="xs:date" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Fecha del documento aduanero</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ImpuestosType">
		<xs:annotation>
			<xs:documentation>Tipo definido para expresar Impuestos</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TipoImp">
				<xs:annotation>
					<xs:documentation>Tipo de impuesto</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="IVA"/>
						<xs:enumeration value="IIBB"/>
						<xs:enumeration value="IPM"/>
						<xs:enumeration value="III"/>
						<xs:enumeration value="IOE"/>
						<xs:enumeration value="OT"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="TasaImp" type="PctType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tasa de impuesto</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:choice>
				<xs:element name="CodTipoIva" type="CodTipoIVAType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              Código de tipo IVA
              1- No Gravado
              2- Exento
              3- 0%
              4- 10,50%
              5- 21%
              6- 27%
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CodTipoTrib" type="CodTipoTribType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              Código de tipo tributo
              01- Impuestos nacionales
              02- Impuestos provinciales
              03- Impuestos municipales
              04- Impuestos internos
              99- Otros
            </xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
			<xs:element name="BaseImp" type="MontoType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Base imponible </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImpteImp" type="MontoType">
				<xs:annotation>
					<xs:documentation>Importe del impuesto</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CodJurisImp" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Código de Jurisdicción </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DscJurisImp" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Jurisdicción de Impuestos Municipales </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Descripcion" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Descripción del tributo para el caso TipoImp = 99(Otros)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RetencionesType">
		<xs:annotation>
			<xs:documentation>Tipo definido para expresar Retenciones</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TipoRet">
				<xs:annotation>
					<xs:documentation>Tipo de retención</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="IVA"/>
						<xs:enumeration value="IIBB"/>
						<xs:enumeration value="IPM"/>
						<xs:enumeration value="III"/>
						<xs:enumeration value="IOB"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="TasaRet" type="PctType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tasa de retención</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImpteRet" type="MontoType">
				<xs:annotation>
					<xs:documentation>Importe retenido</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CodJurisRet" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Código de Jurisdicción </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DscJurisRet" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Jurisdicción de Impuestos Municipales </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="MontoType">
		<xs:annotation>
			<xs:documentation>Monto de 15 dígitos, 13 enteros, 2 decimales</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="15"/>
			<xs:fractionDigits value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MontoType1303">
		<xs:annotation>
			<xs:documentation>Monto de 16 dígitos, 13 enteros, 3 decimales</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="16"/>
			<xs:fractionDigits value="3"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MontoType1806">
		<xs:annotation>
			<xs:documentation>Monto de 24 dígitos, 18 enteros, 6 decimales</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="24"/>
			<xs:fractionDigits value="6"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="QuantityType">
		<xs:annotation>
			<xs:documentation>Monto de 12 dígitos, 7 enteros, 5 decimales</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="12"/>
			<xs:fractionDigits value="5"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FctConv">
		<xs:annotation>
			<xs:documentation>Monto de 10 dígitos, 4 enteros, 6 decimales</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="10"/>
			<xs:fractionDigits value="6"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DTECodeType">
		<xs:annotation>
			<xs:documentation>Tipos de Documentos Tributarios Electrónicos</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:enumeration value="1">
				<xs:annotation>
					<xs:documentation>Factura Electronica A</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="2">
				<xs:annotation>
					<xs:documentation>Nota de Credito Electronica A</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="3">
				<xs:annotation>
					<xs:documentation>Nota de Debito Electronica A</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="4"/>
			<xs:enumeration value="5"/>
			<xs:enumeration value="6">
				<xs:annotation>
					<xs:documentation>Factura Electronica B</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="7">
				<xs:annotation>
					<xs:documentation>Nota de Credito Electronica B</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="8">
				<xs:annotation>
					<xs:documentation>Nota de Debito Electronica T</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="9"/>
			<xs:enumeration value="10"/>
			<xs:enumeration value="11">
				<xs:annotation>
				<xs:documentation>Factura Electronica C</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="12">
				<xs:annotation>
					<xs:documentation>Nota Debito C</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="13">
				<xs:annotation>
					<xs:documentation>Nota Credito C</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="39"/>
			<xs:enumeration value="40"/>
			<xs:enumeration value="51">
				<xs:annotation>
					<xs:documentation>Factura Electronica M</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="52">
				<xs:annotation>
					<xs:documentation>Nota Debito M</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="53">
				<xs:annotation>
					<xs:documentation>Nota Credito M</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="60"/>
			<xs:enumeration value="61"/>
			<xs:enumeration value="63"/>
			<xs:enumeration value="64"/>
			<xs:enumeration value="99">
				<xs:annotation>
					<xs:documentation>Remito</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="201">
				<xs:annotation>
					<xs:documentation>Factura de Credito A</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="202">
				<xs:annotation>
					<xs:documentation>Nota de Credito A</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="203">
				<xs:annotation>
					<xs:documentation>Nota de Debito A</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="206">
				<xs:annotation>
					<xs:documentation>Factura de Credito B</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="207">
				<xs:annotation>
					<xs:documentation>Nota de Credito B</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="208">
				<xs:annotation>
					<xs:documentation>Nota de Debito B</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="211">
				<xs:annotation>
					<xs:documentation>Factura de Credito C</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="212">
				<xs:annotation>
					<xs:documentation>Nota de Credito C</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="213">
				<xs:annotation>
					<xs:documentation>Nota de Debito C</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CUITType">
		<xs:annotation>
			<xs:documentation>Clave Unica de Identificación Tributaria</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:long">
			<xs:totalDigits value="11"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DIRcpType">
		<xs:annotation>
			<xs:documentation>Documento de Identidad del Receptor</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:long">
			<xs:totalDigits value="11"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PctType">
		<xs:annotation>
			<xs:documentation>Monto de Porcentaje ( 3 y 2)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="5"/>
			<xs:fractionDigits value="2"/>
			<xs:minInclusive value="0"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TipoRespType">
		<xs:annotation>
			<xs:documentation>Tipo de responsable tributario</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:byte">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
			<xs:enumeration value="5"/>
			<xs:enumeration value="6"/>
			<xs:enumeration value="7"/>
			<xs:enumeration value="8"/>
			<xs:enumeration value="9"/>
			<xs:enumeration value="10"/>
			<xs:enumeration value="11"/>
			<xs:enumeration value="12"/>
			<xs:enumeration value="13"/>
			<xs:enumeration value="14"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CodTipoIVAType">
		<xs:annotation>
			<xs:documentation>Tipo de dato para el Código de tipo IVA</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:enumeration value="1">
				<xs:annotation>
					<xs:documentation>No Gravado</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="2">
				<xs:annotation>
					<xs:documentation>Exento</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="3">
				<xs:annotation>
					<xs:documentation>0%</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="4">
				<xs:annotation>
					<xs:documentation>10,50%</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="5">
				<xs:annotation>
					<xs:documentation>21%</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="6">
				<xs:annotation>
					<xs:documentation>27%</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CodTipoTribType">
		<xs:annotation>
			<xs:documentation>Tipo de dato para el Código de tipo tributo</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:enumeration value="01">
				<xs:annotation>
					<xs:documentation>Impuestos nacionales</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="02">
				<xs:annotation>
					<xs:documentation>Impuestos provinciales</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="03">
				<xs:annotation>
					<xs:documentation>Impuestos municipales</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="04">
				<xs:annotation>
					<xs:documentation>Impuestos internos</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="99">
				<xs:annotation>
					<xs:documentation>Otros</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
