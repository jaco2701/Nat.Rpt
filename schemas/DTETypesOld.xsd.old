<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2005 rel. 3 U (http://www.altova.com) by  () -->
<xs:schema xmlns="http://www.afip.com.ar/fe" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" targetNamespace="http://www.afip.com.ar/fe" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:complexType name="DTEType">
		<xs:annotation>
			<xs:documentation>Documento Tributario Electrónico</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Documento">
				<xs:annotation>
					<xs:documentation>Informacion del Comprobante</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Encabezado">
							<xs:annotation>
								<xs:documentation>Identificacion y Totales del Documento</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="IdDoc">
										<xs:annotation>
											<xs:documentation>Identificacion del documento</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="NroTmte" type="xs:integer">
													<xs:annotation>
														<xs:documentation>Número de aprobación</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="FechaTmte" type="xs:date" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Fecha del trámite de solicitud de FE o actualización.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Tipo" type="DTECodeType">
													<xs:annotation>
														<xs:documentation>Tipo de documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="CodOper" type="xs:string" minOccurs="0">
													<xs:annotation>
														<xs:documentation>
                              Codigo operación. Valores posibles:  Z Exportaciones a la zona franca;
                              X Exportaciones al exterior;
                              E Operaciones exentas;
                              Blanco Caso contrario
                            </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Serie">
													<xs:annotation>
														<xs:documentation>Nro. de serie del documento</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:int">
															<xs:minInclusive value="1"/>
															<xs:maxInclusive value="9998"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="Numero" type="xs:long">
													<xs:annotation>
														<xs:documentation>Número del documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Estado" default="ORIGINAL">
													<xs:annotation>
														<xs:documentation>Estado del documento</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="ORIGINAL"/>
															<xs:enumeration value="DUPLICADO"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="NroInt" type="xs:string" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Número interno del documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="FechaEmis" type="xs:dateTime">
													<xs:annotation>
														<xs:documentation>Fecha y Hora de Emision Contable del documento (dd-MM-yyyy HH:mm:ss)</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="IndServ" minOccurs="0">
													<xs:annotation>
														<xs:documentation>
                              Indica si este documento corresponde a la presentación de un servicio
                              1-Productos
                              2-Servicios
                              3-Productos y Servicios
                            </xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:positiveInteger">
															<xs:enumeration value="1"/>
															<xs:enumeration value="2"/>
															<xs:enumeration value="3"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="FchServIni" type="xs:date" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Fecha de inicio del período del servicio</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="FchServFin" type="xs:date" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Fecha de fin del período del servicio</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="FormaPago" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Forma de pago del documento</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="50"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CodTermPago" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Codigo del término de pago acordado</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="25"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DiasTermPago" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Días de vencimiento del pago</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:positiveInteger">
															<xs:totalDigits value="3"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="FechaVenc" type="xs:date">
													<xs:annotation>
														<xs:documentation>Fecha de vencimiento del documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="FechaPago" type="xs:date" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Fecha en que el documento fue pagado</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="WSRegimen" type="xs:string" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Régimen del Web Services para la autorización del documento </xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Emisor">
										<xs:annotation>
											<xs:documentation>Datos del emisor del documento</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="CUITEmi" type="CUITType">
													<xs:annotation>
														<xs:documentation>CUIT del emisor</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="NmbEmi">
													<xs:annotation>
														<xs:documentation>Nombre del emisor</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="TpoRespIVA" type="TipoRespType">
													<xs:annotation>
														<xs:documentation>Tipo de responsabilidad tributaria</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="FechaIniAct" type="xs:date">
													<xs:annotation>
														<xs:documentation>Fecha de inicio de actividades</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="CodEmi" minOccurs="0" maxOccurs="5">
													<xs:annotation>
														<xs:documentation>Códigos internos del emisor</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="TpoCodEmi">
																<xs:annotation>
																	<xs:documentation>Tipo de código</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:maxLength value="40"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:element>
															<xs:element name="VlrCodEmi">
																<xs:annotation>
																	<xs:documentation>Valor del código</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:maxLength value="40"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="Sucursal" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Sucursal que emite el documento</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string"/>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CodVend" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Codigo del vendedor</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="60"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="NmbVend" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Nombre del vendedor</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="60"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="EmailVend" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Email del vendedor</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="100"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DirEmi" type="DireccionType">
													<xs:annotation>
														<xs:documentation>Dirección fiscal del emisor</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="LugarExped" type="DireccionType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Lugar de emisión del documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="IIBBEmi" type="IIBBType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Datos de IIBB</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Receptor">
										<xs:annotation>
											<xs:documentation>Datos del receptor del documento</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="DIRcp" type="DIRcpType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Documento de identidad del receptor</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="IdImpositivo" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Clave de identificación tributaria del receptor solicitada a AFIP.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="50"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="TpoDIRcp">
													<xs:annotation>
														<xs:documentation>Tipo de documento de identidad del receptor (00: C.I. Policía Federal, 80: CUIT, 86: CUIL, 87: CDI, 89: LE, 90: LC, 96: DNI, 94:  Pasaporte, 99:Otros )</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:byte">
															<xs:totalDigits value="2"/>
															<xs:enumeration value="00"/>
															<xs:enumeration value="01"/>
															<xs:enumeration value="02"/>
															<xs:enumeration value="03"/>
															<xs:enumeration value="04"/>
															<xs:enumeration value="05"/>
															<xs:enumeration value="06"/>
															<xs:enumeration value="07"/>
															<xs:enumeration value="08"/>
															<xs:enumeration value="09"/>
															<xs:enumeration value="10"/>
															<xs:enumeration value="11"/>
															<xs:enumeration value="12"/>
															<xs:enumeration value="13"/>
															<xs:enumeration value="14"/>
															<xs:enumeration value="16"/>
															<xs:enumeration value="17"/>
															<xs:enumeration value="18"/>
															<xs:enumeration value="19"/>
															<xs:enumeration value="20"/>
															<xs:enumeration value="21"/>
															<xs:enumeration value="22"/>
															<xs:enumeration value="23"/>
															<xs:enumeration value="24"/>
															<xs:enumeration value="80"/>
															<xs:enumeration value="86"/>
															<xs:enumeration value="87"/>
															<xs:enumeration value="89"/>
															<xs:enumeration value="90"/>
															<xs:enumeration value="91"/>
															<xs:enumeration value="92"/>
															<xs:enumeration value="93"/>
															<xs:enumeration value="94"/>
															<xs:enumeration value="95"/>
															<xs:enumeration value="96"/>
															<xs:enumeration value="99"/>
															<xs:enumeration value="30"/>
															<xs:enumeration value="88"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="NmbRcp">
													<xs:annotation>
														<xs:documentation>Nombre del receptor</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="100"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="TpoRespIVA" type="TipoRespType">
													<xs:annotation>
														<xs:documentation>Tipo de responsabilidad tributaria</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="FechaIniAct" type="xs:date">
													<xs:annotation>
														<xs:documentation>Fecha de inicio de actividades</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="CodRcp" minOccurs="0" maxOccurs="5">
													<xs:annotation>
														<xs:documentation>Códigos internos del receptor</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="TpoCodRcp">
																<xs:annotation>
																	<xs:documentation>Tipo de código</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:maxLength value="40"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:element>
															<xs:element name="VlrCodRcp">
																<xs:annotation>
																	<xs:documentation>Valor del código</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:maxLength value="40"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="Sucursal" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Sucursal o departamento que recibe el documento</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string"/>
													</xs:simpleType>
												</xs:element>
												<xs:element name="FonoCont" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Telefono de contacto del receptor</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="80"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="EmailCont" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Email de contacto del receptor</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="100"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DirRcp" type="DireccionType">
													<xs:annotation>
														<xs:documentation>Dirección fiscal del receptor</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="LugarRecep" type="DireccionType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Lugar de recepción de la mercadería o los servicios</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="IIBBRcp" type="IIBBType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Datos de IIBB</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Transporte" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Datos asociados al transporte de la mercadería</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="CUITTrp" type="CUITType">
													<xs:annotation>
														<xs:documentation>CUIT del transportista</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="NmbTrp">
													<xs:annotation>
														<xs:documentation>Nombre del transportista</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="TipoResp" type="TipoRespType">
													<xs:annotation>
														<xs:documentation>Tipo de responsabilidad tributaria</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="FechaIniAct" type="xs:date">
													<xs:annotation>
														<xs:documentation>Fecha de inicio de actividades</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="DirTrp" type="DireccionType">
													<xs:annotation>
														<xs:documentation>Dirección fiscal del transportista</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="IIBBTrp" type="IIBBType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Datos de IIBB</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Totales">
										<xs:annotation>
											<xs:documentation>Importes totales del documento</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="Moneda" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Tipo de moneda</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="3"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="FctConv" type="FctConv" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Factor de conversión a moneda local</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteNeto" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe neto del documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteExe" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe exento del documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteNetoNG" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe de los tributos que no integren el precio neto gravado</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteDcto" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe de los descuentos aplicados</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteRcgo" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe de los recargos aplicados</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteLiq" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe liquidado</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="TasaIVA" type="PctType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Tasa de IVA</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteIVA" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Impuesto liquidado</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="CantAlicuotas" type="xs:string" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Cantidad de Alícuotas de IVA que se exprearan en el documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteIVARNI" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Impuesto liquidado a RNI o percepción a no categorizados</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpSubTotal" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>
                              Importe subtotal
                              ImpteNeto+ImpteNetoNG +ImpteExe
                            </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteTotal" type="MontoType">
													<xs:annotation>
														<xs:documentation>Importe total del documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="VlrPagar" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Valor total a pagar del documento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImptePcps" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe de percepciones o pagos a cuenta de impuestos nacionales</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImptePcpIIBB" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe de percepción de ingresos brutos</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImptePcpMunic" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe de percepción por impuestos municipales</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImptePcpInt" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe de impuestos internos</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteTributos" type="MontoType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Importe de la suma de todos los tributos</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Impuestos" type="ImpuestosType" minOccurs="0" maxOccurs="40">
										<xs:annotation>
											<xs:documentation>Detalle de impuestos aplicados</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Retenciones" type="RetencionesType" minOccurs="0" maxOccurs="40">
										<xs:annotation>
											<xs:documentation>Detalle de retenciones aplicadas</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Aduana" type="AduanaType" minOccurs="0" maxOccurs="30">
										<xs:annotation>
											<xs:documentation>Datos de la aduana (permisos) para factura de exportación</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="Detalle" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Detalle de itemes</xs:documentation>
								<xs:documentation>Detalle de Itemes</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="NroLinDet">
										<xs:annotation>
											<xs:documentation>Número secuencial de línea</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:positiveInteger">
												<xs:maxInclusive value="99999"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="CodItem" minOccurs="0" maxOccurs="5">
										<xs:annotation>
											<xs:documentation>Codificacion del ítem</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="TpoCodigo">
													<xs:annotation>
														<xs:documentation>Tipo de Codificacion</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="40"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="VlrCodigo">
													<xs:annotation>
														<xs:documentation>Valor del Codigo de Item, para la Codificacion Particular</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="35"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Indicador" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Indicador (1: Exento, 2: No Gravado)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:byte">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="DscLang" default="ES">
										<xs:annotation>
											<xs:documentation>Idioma en que se expresa la descripción</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:length value="2"/>
												<xs:enumeration value="EN"/>
												<xs:enumeration value="ES"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="DscItem">
										<xs:annotation>
											<xs:documentation>Descripcion del item</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:whiteSpace value="collapse"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="QtyItem" type="QuantityType">
										<xs:annotation>
											<xs:documentation>Cantidad del item</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="SubQtyItem" minOccurs="0" maxOccurs="5">
										<xs:annotation>
											<xs:documentation>Distribución de la cantidad</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="SubQty" type="xs:integer">
													<xs:annotation>
														<xs:documentation>Cantidad  Distribuida</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="SubCod">
													<xs:annotation>
														<xs:documentation>Codigo Descriptivo de la Subcantidad</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="35"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="FechaElab" type="xs:date" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Fecha de elaboración del ítem</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="FechaVenc" type="xs:date" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Fecha de vencimiento del ítem</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="UnidMed" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Unidad de medida</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string"/>
										</xs:simpleType>
									</xs:element>
									<xs:element name="PrcBruto" type="MontoType1303" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Precio bruto unitario (sin descuentos ni recargos)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="PrcNeto" type="MontoType1806">
										<xs:annotation>
											<xs:documentation>Precio neto unitario (con descuentos y recargos)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="OtraMon" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Precio en otra moneda</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="PrcOtraMon" type="MontoType">
													<xs:annotation>
														<xs:documentation>Precio unitario en otra moneda</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Moneda">
													<xs:annotation>
														<xs:documentation>Código de la moneda</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="3"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="FctConv" type="MontoType">
													<xs:annotation>
														<xs:documentation>Factor de conversión</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="PctDcto" type="PctType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Porcentaje de descuento aplicado al ítem</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ImpteDcto" type="MontoType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Importe de descuento aplicado al ítem</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="SubDcto" minOccurs="0" maxOccurs="5">
										<xs:annotation>
											<xs:documentation>Desglose de los descuentos aplicados al ítem</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="TipoDcto" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Tipo de Descuento</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="30"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="GlosaDcto" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Glosa del Descuento</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="80"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="PctDcto" type="PctType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Porciento de Descuento</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpteDcto" type="xs:decimal">
													<xs:annotation>
														<xs:documentation>Importe del Descuento</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="PctRcgo" type="PctType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Porcentaje de recargo aplicado al ítem</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ImpteRcgo" type="MontoType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Importe de recargo aplicado al ítem</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="SubRcgo" minOccurs="0" maxOccurs="5">
										<xs:annotation>
											<xs:documentation>Desglose de los recargos aplicados al ítem</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="TipoRecargo" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Tipo de Recargo</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="30"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="GlosaRecargo" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Glosa del Recargo</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="80"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="PctRecargo" type="PctType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Porcentaje de Recargo</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ImpRecargo" type="xs:decimal">
													<xs:annotation>
														<xs:documentation>Importe del Recargo</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="SubImpDet" type="ImpuestosType" minOccurs="0" maxOccurs="40">
										<xs:annotation>
											<xs:documentation>Desglose de los impuestos aplicados al ítem</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="SubRetDet" type="RetencionesType" minOccurs="0" maxOccurs="40">
										<xs:annotation>
											<xs:documentation>Desglose de las retenciones aplicadas al ítem</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ImpteBruto" type="MontoType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Importe bruto del ítem (sin descuentos ni recargos ni impuestos)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ImpteNeto" type="MontoType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Importe neto del ítem (con descuentos y recargos sin impuestos)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ImpteTotal" type="MontoType">
										<xs:annotation>
											<xs:documentation>Importe total del ítem (con descuentos, recargos e impuestos)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="TpoDocRef" minOccurs="0">
										<xs:annotation>
