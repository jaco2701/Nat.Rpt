							</xs:annotation>
						</xs:element>
						<xs:element name="FechaVtoAut" type="xs:date">
							<xs:annotation>
								<xs:documentation>Fecha de vencimiento de la autorización otorgada</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="TimeStampAut" type="xs:dateTime">
							<xs:annotation>
								<xs:documentation>Fecha y hora en que se otorgó la autorización</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="BarCode" type="xs:string"/>
						<xs:element name="BarCodeFont" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
